diff --git a/acestep/api/http/model_init_service.py b/acestep/api/http/model_init_service.py
index 73e1bb8..ed8e147 100644
--- a/acestep/api/http/model_init_service.py
+++ b/acestep/api/http/model_init_service.py
@@ -106,6 +106,17 @@ def initialize_models_for_request(
     compile_model = env_bool("ACESTEP_COMPILE_MODEL", False)
     device = os.getenv("ACESTEP_DEVICE", "auto")
 
+    # Resolve quantization: env override > GPU tier default > None
+    _q_env = os.getenv("ACESTEP_QUANTIZATION", "").strip().lower()
+    if _q_env in ("", "none", "null"):
+        quantization = None
+    elif _q_env in ("int8_weight_only", "fp8_weight_only", "w8a8_dynamic"):
+        quantization = _q_env
+    else:
+        quantization = None
+    if quantization is None and gpu_config.quantization_default:
+        quantization = "int8_weight_only"
+
     ensure_model_downloaded(target_model, checkpoint_dir)
     ensure_model_downloaded("vae", checkpoint_dir)
 
@@ -115,6 +126,7 @@ def initialize_models_for_request(
         device=device,
         use_flash_attention=use_flash_attention,
         compile_model=compile_model,
+        quantization=quantization,
         offload_to_cpu=offload_to_cpu,
         offload_dit_to_cpu=offload_dit_to_cpu,
     )
