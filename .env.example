DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ACESTEP_MODEL_DIR=./models/ace-step-1.5
# After training: point to LoRA adapter dir / safetensors (requires ACESTEP_BACKEND=api)
# ACESTEP_LORA_PATH=G:/AI_Music/vendor/ACE-Step-1.5/lora_workspace/output/from_top_songs/final
# Prefer lower-loss checkpoint if needed, e.g. .../checkpoints/epoch_30_loss_0.8057
# ACESTEP_LORA_SCALE=0.8
# ACESTEP_LORA_ADAPTER_NAME=ai_music
OUTPUT_DIR=./outputs
DATABASE_URL=sqlite:///./data/app.db
API_HOST=127.0.0.1
API_PORT=8000
ACESTEP_INFERENCE_STEPS=25
ACESTEP_GUIDANCE_SCALE=7.0

# Post-generation vocal humanization (demucs -> frame repair -> de_buzz EQ).
# Set VOCAL_HUMANIZE_ENABLED=false to get the raw ACE-Step output.
# NOTE: only used by the legacy "acestep" backend. The redesigned "heartmula"
# backend (default) never post-processes audio.
VOCAL_HUMANIZE_ENABLED=true
VOCAL_HUMANIZE_VARIANT=de_buzz

# Generation backend:
#   heartmula (default) - redesigned source-clean pipeline: HeartMuLa official
#     recommended weights -> native 48k WAV -> linear loudness normalization.
#     NO post-processing. Zero repair chain.
#   acestep - legacy ACE-Step draft backend (uses humanize chain above).
GENERATION_BACKEND=heartmula

# RVC: auto-detects G:\Cover_vision vp_v2_48k when present.
# COVER_VISION_ROOT=G:\Cover_vision
# RVC_DISABLE_AUTO=1
# RVC_ENABLED=1
# RVC_DEVICE=cuda
# RVC_MODEL_PATH=G:\Cover_vision\rvc-webui\assets\weights\vp_v2_48k.pth
# RVC_INDEX_PATH=G:\Cover_vision\rvc-webui\logs\vp_v2_48k\added_IVF256_Flat.index
# Optional override (otherwise Cover_vision tools/rvc_infer.py is used):
# RVC_INFER_CMD=G:\Cover_vision\.venv\python.exe G:\Cover_vision\tools\rvc_infer.py --model_path {model} --index_path {index} --input {input} --output {output} --f0_method rmvpe --device cuda
